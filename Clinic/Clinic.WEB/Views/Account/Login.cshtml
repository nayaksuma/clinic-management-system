
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width" , initial-scale="1">
    <title>Login</title>
    @Styles.Render("~/content/css")
    <style type="text/css">
        .back-image {
            background-image: url("/images/doctors.jpg");
            background-color:#4cff00;
            height: 500px;
            background-size: cover; 
        }
    </style>
</head>

<body class="back-image">
    <div class="container">
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-5">
                @using (Html.BeginForm())
                {

                    <div class="card text-dark bg-info mb-3">
                        <div class="card-header">
                            Login
                        </div>
                        <div class="card-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">
                                <div class="col-12">
                                    &nbsp;
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    User Name
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="form-control" name="UserName"
                                           id="UserName" placeholder="User Name" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    &nbsp;
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    Password
                                </div>
                                <div class="col-md-6">
                                    <input type="password" name="Password" id="Password" class="form-control" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    &nbsp;
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="row">
                                <div class="col-12">
                                    &nbsp;
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <input type="submit" id="btnPatient" name="btnPatient" class=" btn btn-secondary" value="Patient" />
                                </div>
                                <div class="col-md-4">
                                    <input type="submit" id="btnDoctor" name="btnDoctor" class=" btn btn-warning" value="Doctor" />
                                </div>
                                <div class="col-md-4">
                                    <input type="submit" id="btnReceptionist" name="btnReceptionist" class=" btn btn-danger" value="Receptionist" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    &nbsp;
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>



