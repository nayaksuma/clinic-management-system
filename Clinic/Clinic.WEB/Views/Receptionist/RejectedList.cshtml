@model IEnumerable<Clinic.WEB.ViewModel.DoctorVisitViewModel>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                <h4>Rejected List</h4>
            </div>
            <div class="col-md-4">
            </div>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-md table-bordered table-striped table-responsive">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.DoctorID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PatientID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Date)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Symptoms)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Precripation)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Payment)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.VisitDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Dateofbooking)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ResultDate)
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model)
            {
                string therClass = "bg-danger";
                <tr class="@therClass">
                    <td>
                        @Html.DisplayFor(modelItem => item.DoctorID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.PatientID)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Symptoms)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Precripation)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Payment)
                    </td>
                    <th>
                        @Html.DisplayFor(modelItem => item.VisitDate)
                    </th>
                    <th>
                        @Html.DisplayFor(modelItem => item.Dateofbooking)
                    </th>
                    <th>
                        @Html.DisplayFor(modelItem => item.Status)
                    </th>
                    <th>
                        @Html.DisplayFor(modelItem => item.ResultDate)
                    </th>
                </tr>
            }

        </table>
    </div>
    <div class="card-footer">
        SAS Clinic
    </div>
</div>





