                </div>
                <div class="col-md-6">
                    @Html.DisplayFor(model => model.Password)
                </div>
            </div>
            @if (Model.Photo == null)
            {
                <h4>
                    No Photo Found in the records,
                    Please upload Photo
                </h4>
            }
            else
            {
                string base64String = Convert.ToBase64String(Model.Photo, 0,
               Model.Photo.Length);
                <img src="data:image/png;base64,@base64String"
                     alt="@Model.Name" class="img-fluid" />
            }
        </div>
