@model Clinic.WEB.Models.PrescribedTestModel
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <h3>Are you sure you want to delete this?</h3>
            </div>
            <div class="col-md-6 text-end">
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-info" })
            </div>
        </div>
    </div>
    <div class="card-body">
        <h4>Report</h4>
        <hr />
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.PatientID)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.PatientID)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.TestID)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.TestID)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.DoctorID)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.DoctorID)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.Fees)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Fees)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.Date)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Date)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                @Html.DisplayNameFor(model => model.Result)
            </div>
            <div class="col-md-6">
                @Html.DisplayFor(model => model.Result)
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                &nbsp;
            </div>
        </div>
    </div>
    <div class="card-footer">

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color">
                <input type="submit" value="Delete" class="btn btn-outline-danger" /> 
            </div>
        }
    </div>
</div>

    

