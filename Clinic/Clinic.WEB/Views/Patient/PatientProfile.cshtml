                </div>
                <div class="col-md-6">

                    <div class="row">
                        <div class="col-md-3 text-end">
                            @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label " })
                        </div>
                        <div class="col-md-8">
